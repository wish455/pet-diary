# 复制为 .env 或直接在平台的环境变量里填写（本项目不依赖 dotenv，容器/平台注入即可）

# ---------- 基础 ----------
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
# 数据目录：数据库与上传图片都放这里，容器部署必须指向挂载的持久磁盘
DATA_DIR=/data

# ---------- 账号与安全 ----------
# 通过 HTTPS 访问时保持 true；纯 http 本地调试可设 false，否则浏览器不会保存会话 Cookie
COOKIE_SECURE=true
# 登录状态保持天数
SESSION_DAYS=30
# 注册开关：0 关闭注册（只有已有账号能登录）
OPEN_REGISTRATION=1
# 邀请码：填写后注册必须输入（留空则不需要）
INVITE_CODE=
# 启动时把这些账号提升为管理员（逗号分隔，账号需已存在）
ADMIN_USERS=

# ---------- 上传 ----------
# 单张图片上限（MB）
MAX_UPLOAD_MB=8

# ---------- 仅开发/自动化截图用，生产环境请勿设置 ----------
# SHOT_TOKEN=
